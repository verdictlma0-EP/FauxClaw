# Fauxclaw configuration – copy to .env if you want, or just use env vars

# Server
FXC_PORT=8083
FXC_HOST=127.0.0.1               # Use 0.0.0.0 if you need external access
FXC_API_KEY=                      # Optional: set to require X-Proxy-Key header

# Performance & limits
FXC_RATE_LIMIT=100                # Requests per minute per IP
FXC_MAX_CONCURRENT=50
FXC_TIMEOUT=30000                 # ms
FXC_MAX_BUFFER=5242880            # 5MB

# Logging
FXC_LOG=info                      # debug, info, warn, error
FXC_METRICS=true

# Provider tokens (these get stored in ~/.fauxclaw/config.json after setup)
# You normally don't set them here – use `fxc setup` instead. ;D
# KIRO_CLIENT_ID=
# KIRO_CLIENT_SECRET=
# KIRO_REFRESH_TOKEN=
# OPENROUTER_API_KEY=
# IFLOW_TOKEN=
